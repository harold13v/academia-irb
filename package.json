{
  "name": "academia-irb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev -p 4200",
    "build": "next build",
    "start": "next start -p 4200 -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/worker/index.ts",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/worker.mjs --packages=external",
    "lint": "eslint src e2e scripts",
    "test": "playwright test",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "session:token": "tsx scripts/session-token.ts"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@sentry/nextjs": "^11.17.0",
    "@serwist/next": "^9.6.0",
    "@tanstack/react-query": "^5.108.4",
    "@vimeo/player": "^2.30.4",
    "bullmq": "^6.7.10",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "motion": "^14.14.0",
    "next": "15.5.29",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serwist": "^9.6.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "mysql2": "^3.15.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@tailwindcss/oxide",
      "msgpackr-extract",
      "@sentry/cli"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
