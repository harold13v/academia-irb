# Copia este archivo a .env.local (desarrollo) y completa los valores. Nunca subas .env* al repo.

# --- obligatorias ---
DATABASE_URL=
REDIS_URL=
# 32+ caracteres aleatorios (firma la cookie de sesión): openssl rand -hex 32
APP_SECRET=
PUBLIC_URL=http://localhost:4200

# --- opcionales ---
NODE_ENV=development
PORT=4200
HOSTNAME=127.0.0.1
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1
# Sin DSN, Sentry no se inicializa
SENTRY_DSN=
# Sin clave, no se envían correos (no hace falta en desarrollo)
BREVO_API_KEY=
# Recordatorios push (npx web-push generate-vapid-keys). Sin claves, el worker no envía recordatorios.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Panel "Pregúntale a IRB": sin clave responde en modo extractivo con el texto de la clase
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Hash privado del video de Fuegos en Vimeo (solo si el video lo exige)
FUEGOS_VIMEO_HASH=
# Título sobre el video (experimento): 1 para activarlo
NEXT_PUBLIC_TITLE_OVER_VIDEO=
NEXT_PUBLIC_SENTRY_DSN=
# web | worker (etiqueta de logs/Sentry)
APP_ROLE=

# --- pruebas (Playwright) ---
# URL contra la que corren las pruebas (por defecto http://localhost:4200)
BASE_URL=
# JWT de una alumna de demo para rutas privadas (ver README)
IRB_SESSION=
# Opcional: carpeta con chrome-headless-shell propio en vez del Chromium de Playwright
QA_CHROME_ROOT=
E2E_ROUTES=
